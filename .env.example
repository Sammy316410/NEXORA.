# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase --------------------------------------------------------------
# Local: run `npx supabase start` and copy the values it prints.
# Hosted: Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable key (sb_publishable_...) or the legacy anon key. Safe for the browser:
# it is only used to receive Realtime "something changed" pings.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) or the legacy service_role key. SERVER ONLY.
SUPABASE_SECRET_KEY=

# --- App -------------------------------------------------------------------
APP_URL=http://localhost:3000
# 32+ random characters. Signs guest sessions. e.g. `openssl rand -hex 32`
NEXORA_SESSION_SECRET=
# true = show the demo launcher on / and the "Reset demo" button
NEXORA_DEMO_MODE=true
# Password for the seeded demo staff accounts
DEMO_STAFF_PASSWORD=nexora-demo-2026

# --- AI (optional) -----------------------------------------------------------
# Without a key, keyword rules sort free-text requests. With a key, Claude does.
ANTHROPIC_API_KEY=

# --- Workpeg (fill in on hackathon day) ---------------------------------------
WORKPEG_API_BASE=https://api.workpeg.com
WORKPEG_ISSUER=https://api.workpeg.com
# Sign in with Workpeg (OpenID Connect). Redirect URI to register:
#   {APP_URL}/auth/workpeg/callback
WORKPEG_CLIENT_ID=
WORKPEG_CLIENT_SECRET=
# Server-to-server key from the Workpeg developer dashboard (API & SDK). SERVER ONLY.
WORKPEG_PK=
# The business UUID the peg is installed in
WORKPEG_BUSINESS_ID=
# Optional: an existing table UUID. Leave blank and NEXORA creates "NEXORA Requests".
WORKPEG_REQUESTS_TABLE=
# Shared secret between the Workpeg peg function and /api/workpeg/actions
NEXORA_BRIDGE_SECRET=
# Inbound permission (guest requests into the peg). Workpeg sets our callback
#   {APP_URL}/api/workpeg/permissions
# and gives this signing secret privately. SERVER ONLY.
WORKPEG_PERMISSION_SECRET=
# 32+ random characters; seals the inbound keys Workpeg sends us.
# e.g. `openssl rand -hex 32`. Falls back to NEXORA_SESSION_SECRET.
WORKPEG_KEY_ENCRYPTION_KEY=

# --- Payments ----------------------------------------------------------------
# The gateway is configuration only; no code changes to switch.
#   sandbox   built-in test gateway with published test cards. No keys, no real money.
#   paystack  Paystack hosted checkout. Test or live is decided by the key itself.
PAYMENT_PROVIDER=sandbox
PAYMENT_CURRENCY=NGN
# Paystack secret key, SERVER ONLY. sk_test_... = test mode (no real money).
# Webhook URL to set in the Paystack dashboard: {APP_URL}/api/payments/webhook/paystack
PAYSTACK_SECRET_KEY=
# A live key (sk_live_...) is refused unless this is exactly "true".
PAYMENTS_ALLOW_LIVE=false
# Optional: signs the sandbox gateway's webhooks. Defaults to NEXORA_SESSION_SECRET.
SANDBOX_WEBHOOK_SECRET=
